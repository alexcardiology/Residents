+
+
+/* ========================================================================== */
+/* v1.0.96 — participation-specific minimum logbook requirements              */
+/* ========================================================================== */
+.minimum-year-tabs{
+  display:flex;
+  flex-wrap:wrap;
+  gap:7px;
+  margin:0 0 10px;
+}
+.minimum-year-tabs button{
+  border:1px solid #c9d8e5;
+  background:#fff;
+  color:#173a60;
+  border-radius:999px;
+  padding:8px 14px;
+  font-weight:850;
+  cursor:pointer;
+}
+.minimum-year-tabs button.active{
+  background:#0b2747;
+  border-color:#0b2747;
+  color:#ffd34f;
+  box-shadow:0 6px 16px rgba(11,39,71,.15);
+}
+.minimum-requirements-mode-table{
+  min-width:980px;
+}
+.minimum-requirements-mode-table th:not(:first-child),
+.minimum-requirements-mode-table td:not(:first-child){
+  text-align:center;
+  min-width:132px;
+}
+.minimum-requirements-mode-table .minimum-requirement-input{
+  width:76px;
+  min-width:76px;
+  margin-inline:auto;
+}
+.minimum-timing-note{
+  display:block;
+  margin:5px auto 0;
+  max-width:120px;
+  color:#8b5a00;
+  font-size:.66rem;
+  line-height:1.2;
+  font-weight:800;
+}
+.minimum-timing-pill{
+  display:inline-flex;
+  max-width:150px;
+  padding:5px 8px;
+  border-radius:999px;
+  background:#fff4cc;
+  color:#7b5200;
+  font-size:.68rem;
+  line-height:1.15;
+  font-weight:850;
+}
+.resident-minimum-table td:nth-child(2){
+  min-width:175px;
+}
+@media (max-width:680px){
+  .minimum-year-tabs{
+    gap:5px;
+  }
+  .minimum-year-tabs button{
+    padding:7px 10px;
+    font-size:.74rem;
+  }
+  .resident-minimum-table{
+    min-width:1040px;
+  }
+}
